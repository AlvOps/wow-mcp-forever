{
  "name": "wow-forever-mcp",
  "version": "2.0.0",
  "description": "MCP server for World of Warcraft: Forever game data, backed by Wowhead",
  "type": "module",
  "private": true,
  "author": "AlvOps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlvOps/wow-mcp-forever.git"
  },
  "bin": {
    "wow-forever-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js --stdio",
    "lint": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "start:http": "node dist/index.js --http",
    "selftest": "node dist/selftest.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "pino": "^9.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
