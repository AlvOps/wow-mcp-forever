# Nothing is required. Everything below is optional.

# ── Transport ───────────────────────────────────────────
# stdio (default): your assistant launches the server itself.
# http: run it as a service and point the assistant at http://host:3000/mcp
# MCP_TRANSPORT=stdio
# PORT=3000
# HOST=0.0.0.0
# Static Bearer token required on /mcp in HTTP mode.
# MCP_AUTH_SECRET=

# ── Wowhead ─────────────────────────────────────────────
# WOWHEAD_ENV=forever
# Numeric tooltip dataEnv, only needed if the path-based tooltip URL stops working.
# WOWHEAD_DATA_ENV=
# WOWHEAD_BASE_URL=https://www.wowhead.com
# WOWHEAD_TOOLTIP_URL=https://nether.wowhead.com

# ── AWS WAF token (entity pages) ────────────────────────
# Where the minted aws-waf-token cookie is cached. Empty -> ~/.wowhead-token.
# WOWHEAD_TOKEN_FILE=
# Chromium used to mint the cookie. Empty -> auto-detect (PATH, then Playwright).
# WOWHEAD_CHROME_PATH=
# How long a cached token is trusted before a fresh one is minted.
# WOWHEAD_TOKEN_MAX_AGE_HOURS=72
# Page loaded to mint the cookie. Empty -> <WOWHEAD_BASE_URL>/<WOWHEAD_ENV>/items
# WOWHEAD_MINT_URL=
# Hard ceiling on one mint, so a wedged browser cannot hang a tool call.
# MINT_DEADLINE_MS=45000
# How long to watch for the challenge cookie before giving up on a mint.
# MINT_COOKIE_WAIT_MS=20000
# After a failed mint, don't spawn another browser for this long.
# MINT_FAILURE_BACKOFF_MS=600000

# ── Tuning ──────────────────────────────────────────────
# LOG_LEVEL=info
# HTTP_TIMEOUT_MS=15000
# HTTP_RETRY_LIMIT=2
# CACHE_TTL_SECONDS=3600
# Raw-payload cache: entries, and a byte ceiling for those entries.
# CACHE_SIZE=200
# CACHE_MAX_BYTES=8000000
# Parsed entity pages kept in memory (entries, not bytes).
# PAGE_CACHE_SIZE=60
# Drop rows below this sample size are ordered after well-sampled ones, so
# "100% of 6 kills" cannot outrank a real drop rate.
# DROP_MIN_SAMPLES=20